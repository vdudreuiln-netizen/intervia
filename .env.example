# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (abonnement 59 € HT / mois)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe : un prix par formule et périodicité (Produits > Tarifs dans le tableau de bord Stripe)
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_EQUIPE_MONTHLY=
STRIPE_PRICE_EQUIPE_YEARLY=
STRIPE_PRICE_ENTREPRISE_MONTHLY=
STRIPE_PRICE_ENTREPRISE_YEARLY=
# Offre de lancement : prix dédié Solo 29 €/mois (ne jamais le modifier ni le supprimer)
STRIPE_PRICE_LAUNCH=

# Adresse e-mail du support affichée dans l'application (page Aide) et les pages légales
NEXT_PUBLIC_SUPPORT_EMAIL=

# Import de tarifs fournisseurs en PDF (lecture par Claude, facultatif).
# Sans clé, seul l'import Excel / CSV est proposé. À saisir dans Vercel, jamais dans le code.
ANTHROPIC_API_KEY=
# Modèle utilisé (facultatif, défaut : claude-opus-5-5)
ANTHROPIC_TARIFF_MODEL=
# Modèle pour la lecture des plans de logement (facultatif, défaut : claude-opus-5-5)
ANTHROPIC_PLAN_MODEL=
